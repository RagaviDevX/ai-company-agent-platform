# GROQ
GROQ_API_KEY=YOUR_GROQ_API_KEY

# OPENROUTER
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# HUGGINGFACE
HUGGINGFACE_API_KEY=YOUR_HUGGINGFACE_API_KEY

# Optional
TAVILY_API_KEY=

# DATABASE
QDRANT_PATH=qdrant_data
SQLITE_DB=database/memory.db
# Optional: redis://localhost:6379/0 -- blank uses an in-memory cache fallback
REDIS_URL=
# Cache TTL (in seconds)
CACHE_TTL_SECONDS=600
# APP
APP_NAME=AI Company
ENV=development
BACKEND_URL=http://127.0.0.1:8000
DEFAULT_USER_ID=1
# AUTH (optional, off by default -- see backend/auth/dependencies.py)
AUTH_ENABLE=Dfals
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440